# Copy to .env to override local Docker defaults. Do not commit .env.
POSTGRES_DB=vehicle_reid
POSTGRES_USER=vehicle_reid
POSTGRES_PASSWORD=change-this-local-password

PORT=8017
REID_PROFILE=MVP_fusion_v25
REID_PROVIDER=CPUExecutionProvider
# GPU overlay forces CUDAExecutionProvider, regardless of the value above.
